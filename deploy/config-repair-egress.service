[Unit]
Description=Independent Ads egress investigation supervisor
After=network-online.target config-repair.service
Wants=network-online.target config-repair.service
StartLimitIntervalSec=0
[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
WatchdogSignal=SIGKILL
TimeoutStartSec=60
User=root
WorkingDirectory=/opt/config-repair/current
ExecStart=/opt/config-repair/current/config-egress-worker
Restart=always
RestartSec=10
TimeoutStopSec=40
KillMode=control-group
UMask=0077
Environment=GOMEMLIMIT=128MiB
MemoryMax=2G
TasksMax=4096
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
