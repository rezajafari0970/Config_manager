[Unit]
Description=Shen VPN residential evidence worker
After=config-repair.service network-online.target
Requires=config-repair.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/config-repair/current/config-residential-worker
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=40
LimitCORE=0
MemoryMax=768M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
