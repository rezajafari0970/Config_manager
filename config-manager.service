[Unit]
Description=Config Manager Web Panel
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
WorkingDirectory=/root/Config_manager
ExecStart=/usr/bin/python3 /root/Config_manager/app/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
